# Copiar a .env y completar. Nunca subir .env al repositorio.
# En producción las variables se definen en el panel del hosting, no en un archivo.

# --- Servidor ---------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
# Prefijo opcional de todas las rutas (vacío, o "/api"). Sin barra final.
API_PREFIX=
LOG_LEVEL=info
# Cantidad de proxies de confianza delante de la API (0 = ninguno). En un hosting detrás de un
# proxy poner 1: así la IP real queda en la auditoría y los límites de intentos funcionan.
TRUST_PROXY=0
# Orígenes permitidos del frontend, separados por coma. Debe ser el origen exacto (https://...).
CORS_ORIGINS=http://localhost:5173
# Peticiones por minuto por IP (general) e intentos de login por IP cada 15 minutos
RATE_LIMIT_MAX=300
LOGIN_RATE_LIMIT_MAX=10

# --- Base de datos ----------------------------------------------------------------------------
# La API se conecta SIEMPRE como hc_app (sin permiso de borrar ni de modificar el historial).
DATABASE_URL=postgres://hc_app:cambiar@localhost:5432/historias_clinicas
# true para hostings administrados (Render, etc.): conexión TLS validando el certificado
DATABASE_SSL=false
# Solo para `npm run migrar`: conexión del rol hc_migrator (dueño del esquema)
MIGRATIONS_DATABASE_URL=postgres://hc_migrator:cambiar@localhost:5432/historias_clinicas
# Solo para `npm run crear-roles` (una vez por base): usuario administrador del hosting y las
# contraseñas (16 caracteres o más, distintas entre sí) que tendrán los dos roles
ADMIN_DATABASE_URL=
HC_MIGRATOR_PASSWORD=
HC_APP_PASSWORD=

# --- Archivos ---------------------------------------------------------------------------------
# local = carpeta del disco (solo desarrollo y tests; se rechaza con NODE_ENV=production)
# s3    = bucket S3-compatible privado (Backblaze B2, Cloudflare R2, MinIO...)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage-local
# Obligatorias con STORAGE_DRIVER=s3
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Tamaño máximo de un archivo subido (acepta decimales). Los límites de cuerpo del proveedor y
# del proxy deben ser mayores o iguales a este valor.
MAX_UPLOAD_MB=25
# Descarga con STORAGE_DRIVER=s3:
#   stream   = el backend transmite el archivo (por defecto)
#   redirect = 302 a una URL firmada de corta duración
DOWNLOAD_MODE=stream
SIGNED_URL_TTL_SECONDS=60

# --- Reportes ---------------------------------------------------------------------------------
# Separador de columnas de los CSV. ";" abre bien en Excel con configuración regional de
# Argentina/España; usar "," para Excel en inglés.
CSV_SEPARADOR=;

# --- Copias de seguridad (npm run backup / npm run restaurar) ---------------------------------
# Conexión con lectura de todas las tablas; si falta se usa MIGRATIONS_DATABASE_URL
BACKUP_DATABASE_URL=
# Días que se conservan las copias del directorio (30 por defecto)
BACKUP_RETENCION_DIAS=30
# Conexión de hc_migrator a la base NUEVA y VACÍA donde se restaura
RESTORE_DATABASE_URL=

# --- Tests de integración ---------------------------------------------------------------------
# Base SEPARADA de la real. Su nombre debe contener "test", "prueba", "dev" o "desarrollo":
# los tests la vacían y la recrean en cada corrida.
TEST_DATABASE_URL=postgres://hc_app:cambiar@host:5432/historias_clinicas_test
TEST_MIGRATIONS_DATABASE_URL=postgres://hc_migrator:cambiar@host:5432/historias_clinicas_test
TEST_DATABASE_SSL=true
# Opcional: correr las pruebas de almacenamiento también contra un bucket S3 real DE PRUEBAS
# (nunca el de producción). Sin estas variables se usa un servidor S3 simulado.
TEST_S3_ENDPOINT=
TEST_S3_REGION=
TEST_S3_BUCKET=
TEST_S3_ACCESS_KEY_ID=
TEST_S3_SECRET_ACCESS_KEY=
