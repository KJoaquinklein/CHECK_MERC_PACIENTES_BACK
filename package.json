{
  "name": "check-merc-pacientes-back",
  "version": "0.1.0",
  "private": true,
  "description": "Backend del sistema de historias clínicas",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/copiar-migraciones.mjs",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "migrar": "tsx --env-file-if-exists=.env src/scripts/migrar.ts",
    "crear-roles": "tsx --env-file-if-exists=.env src/scripts/crear-roles.ts",
    "crear-admin": "tsx --env-file-if-exists=.env src/scripts/crear-admin.ts",
    "migrar:prod": "node dist/scripts/migrar.js",
    "crear-roles:prod": "node dist/scripts/crear-roles.js",
    "crear-admin:prod": "node dist/scripts/crear-admin.js",
    "backup": "node scripts/ejecutar-sh.mjs scripts/backup.sh",
    "restaurar": "node scripts/ejecutar-sh.mjs scripts/restaurar.sh"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@aws-sdk/s3-request-presigner": "^3.1161.0",
    "argon2": "^0.45.2",
    "busboy": "^1.6.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "file-type": "^22.3.0",
    "helmet": "^8.3.0",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "@eslint/js": "^10.0.1",
    "@types/busboy": "^1.5.5",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
